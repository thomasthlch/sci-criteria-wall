// =============================================================================
// FRAGMENT ONLY — 這不是完整的 storage.rules。
// 不可單獨部署。單獨部署會覆蓋 mrli-thlch 現有 Storage 規則。
// 請把下面的 function 與 match 合併進「現有」Storage 規則，放在
//   service firebase.storage { match /b/{bucket}/o { ... } }
// 裡面、與其他 match 並列。Firebase Hosting 部署不在本專案範圍。
// 只限 src/allowlist.js 列出、而且 email_verified 的帳戶可讀寫 sci_criteria_wall/。
// =============================================================================

    function sciCriteriaWallTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'thomasthlch@gmail.com',
          'laipuiyee@tswgps.edu.hk',
          'wongwingyan@tswgps.edu.hk',
          'chanpuishan@tswgps.edu.hk',
          'wongpikkei@tswgps.edu.hk',
          'aukamling@tswgps.edu.hk',
          'leekaying@tswgps.edu.hk',
          'chankailok@tswgps.edu.hk',
          'chauhangfung@tswgps.edu.hk',
          'chanshuion@tswgps.edu.hk',
          'liyuenman@tswgps.edu.hk',
          'lichihong@tswgps.edu.hk',
          'cheunghin@tswgps.edu.hk',
          'tsehiuhung@tswgps.edu.hk'
        ];
    }

    match /sci_criteria_wall/{allPaths=**} {
      allow read: if sciCriteriaWallTeacher();
      allow create, update: if sciCriteriaWallTeacher()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sciCriteriaWallTeacher();
    }
