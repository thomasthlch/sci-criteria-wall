// =============================================================================
// FRAGMENT ONLY — 這不是完整的 firestore.rules。
// 要發佈到 mrli-thlch 的完整規則在 firebase/firestore.rules。
// 這份片段只記錄準則牆那一段，方便對照。不要單獨部署。
// Firebase Hosting 部署不在本專案範圍。
// =============================================================================

    function sciCriteriaWallAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'thomasthlch@gmail.com';
    }

    function sciCriteriaWallTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower().matches('.+@tswgps[.]edu[.]hk')
          || request.auth.token.email.lower() == 'thomasthlch@gmail.com'
        );
    }

    match /sci_criteria_wall/{path=**} {
      allow read: if sciCriteriaWallTeacher();
      allow create, update: if sciCriteriaWallTeacher();
      allow delete: if sciCriteriaWallTeacher()
        && !path.matches('wall/questions/[^/]+');
    }

    match /sci_criteria_wall/wall/questions/{questionId} {
      allow delete: if sciCriteriaWallAdmin()
        || (
          sciCriteriaWallTeacher()
          && resource.data.keys().hasAll(['createdBy'])
          && resource.data.createdBy is map
          && resource.data.createdBy.uid == request.auth.uid
        );
    }
